@model LibraryManagement.Domain.Entities.Book

<h2>إضافة كتاب جديد</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label class="form-label">عنوان الكتاب</label>
        <input asp-for="Title" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">الرقم المعياري (ISBN)</label>
        <input asp-for="ISBN" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">سنة النشر</label>
        <input asp-for="PublishedYear" type="number" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">إجمالي النسخ</label>
        <input asp-for="TotalCopies" type="number" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">النسخ المتاحة</label>
        <input asp-for="AvailableCopies" type="number" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-success">حفظ</button>
    <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
</form>